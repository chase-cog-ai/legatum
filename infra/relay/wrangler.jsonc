{
  // Legatum relay: a public lobby and a dumb pipe. No account id or secrets live here.
  // Set CLOUDFLARE_API_TOKEN (and CLOUDFLARE_ACCOUNT_ID if the token sees several accounts) when deploying.
  "name": "legatum-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The public address. A custom domain puts the Worker behind the zone's rate-limiting rule (README "Edge rule").
  "routes": [{ "pattern": "relay.playlegatum.com", "custom_domain": true }],
  // No workers.dev address: it would sit outside the edge rule, and no kept build calls it.
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    // new_sqlite_classes: SQLite-backed Durable Objects, the only kind the Workers Free plan allows.
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "Room"] }
  ],
  // Tunables (README "Limits and kill switch"). Strings, as Worker vars are; a bad value falls back to the default.
  "vars": {
    "LOBBY_OPEN": "1", // "0" refuses new rooms with 503; running rooms carry on
    "MAX_ROOMS": "256", // rooms on the whole relay
    "MAX_ROOMS_PER_IP": "2", // live rooms per client address
    "MAX_ROOMS_PER_NET": "8", // live rooms per network (IPv4 /24, IPv6 /48)
    "ROOM_CREATES_PER_10_MIN": "6", // room creations per client address in any 10 minutes
    "MAX_GUESTS_PER_IP": "4" // guest sockets per client address in one room
  },
  "observability": { "enabled": false }
}
